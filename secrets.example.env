# sprout worktree-db secrets (chmod 600). Never commit real values.
# Admin DSN needs CREATEROLE (and CREATEDB / ability to create databases).
SPROUT_WORKTREE_ADMIN_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# Optional: preview owner role for `attach-preview`.
# SPROUT_PREVIEW_OWNER_URL=postgres://sprout_preview:CHANGE_ME@127.0.0.1:5432/postgres
# SPROUT_URL=https://sprout.example.com
# SPROUT_ADMIN_TOKEN=sprout_…
# SPROUT_PG_HOST=127.0.0.1
# SPROUT_PG_PORT=5432
