#!/usr/bin/env python3
"""Thin entrypoint for herdr plugin hooks / actions / CLI."""

from __future__ import annotations

import sys
from pathlib import Path

# Package lives next to bin/; ensure import works when invoked as a script.
_ROOT = Path(__file__).resolve().parents[1]
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

from sprout_worktree_db.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
